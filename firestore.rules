rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // GUJARAT INFRAMAP — PRODUCTION FIRESTORE SECURITY RULES
    // Default Deny: All collections and unspecified documents are closed by default.
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for authentication & authorization
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Whitelist and validate user passport profile schema
    function isValidProfileData(userId) {
      let data = request.resource.data;
      let allowedKeys = [
        'uid', 'name', 'handle', 'email', 'phoneNumber', 
        'photoURL', 'authProvider', 'homeDistrict', 'collectedStampIds', 
        'bookmarkedStoryIds', 'visitedPlaceIds', 'badges', 
        'lastCheckedInDistrict', 'joinedDate', 'isLoggedIn', 'updatedAt'
      ];
      
      return data.keys().hasOnly(allowedKeys) &&
             data.uid == userId &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.homeDistrict is string && data.homeDistrict.size() <= 50 &&
             data.collectedStampIds is list && data.collectedStampIds.size() <= 34 &&
             (!('email' in data) || data.email is string) &&
             (!('phoneNumber' in data) || data.phoneNumber is string) &&
             (!('photoURL' in data) || data.photoURL is string) &&
             (!('badges' in data) || data.badges is list);
    }

    // -------------------------------------------------------------------------
    // 1. Private User Profiles & Passports
    // Only the authenticated account owner may read, create, update, or delete their profile.
    // Cross-user reading and writing are strictly prohibited.
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidProfileData(userId);
      allow delete: if isOwner(userId);
    }

    // -------------------------------------------------------------------------
    // 2. Public Read-Only Infrastructure & Destinations (If mirrored in Firestore)
    // Anonymous visitors can read verified GIS metadata; no client writes permitted.
    // -------------------------------------------------------------------------
    match /public_infrastructure/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /tourist_destinations/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
