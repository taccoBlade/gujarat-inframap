# =============================================================================
# GUJARAT INFRAMAP — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to '.env.local' for local development.
# IMPORTANT: NEVER commit '.env.local' or any file containing private keys to Git.
#
# Firebase Client Configuration (Safe for client-side embedding with domain restrictions):
# Obtain these values from the Firebase Console (Project Settings -> General -> Your apps -> Web app)
# Note: Google Identity Services / Firebase client API keys are domain-restricted in Google Cloud Console.
# =============================================================================

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_web_app_id
