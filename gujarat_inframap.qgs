<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE qgis PUBLIC 'http://mrcc.com/qgis.dtd' 'SYSTEM'>
<qgis projectname="Gujarat InfraMap" version="3.34.0">
  <title>Gujarat InfraMap — Infrastructure Digital Twin GIS</title>
  <homePath path=""/>
  <layer-tree-group>
    <customproperties/>
    <layer-tree-layer name="District Headquarters Nodes" id="district_hq" checked="Qt::Checked" expanded="1" source="./data/gujarat_district_hq.geojson" providerKey="ogr"/>
    <layer-tree-layer name="Gujarat Water Systems Network &amp; Dams" id="water_resources" checked="Qt::Checked" expanded="1" source="./data/gujarat_water_resources.geojson" providerKey="ogr"/>
    <layer-tree-layer name="Commercial Ports, Airports, SEZs &amp; Metro" id="urban_industry" checked="Qt::Checked" expanded="1" source="./data/gujarat_urban_industry.geojson" providerKey="ogr"/>
    <layer-tree-layer name="High-Voltage Substations &amp; Grid Nodes" id="substations" checked="Qt::Checked" expanded="1" source="./data/gujarat_transmission.geojson" providerKey="ogr"/>
    <layer-tree-layer name="GETCO &amp; PowerGrid Transmission Corridors (400kV/765kV)" id="transmission_lines" checked="Qt::Checked" expanded="1" source="./data/gujarat_transmission.geojson" providerKey="ogr"/>
    <layer-tree-layer name="Power and Energy Generation Facilities" id="power_plants" checked="Qt::Checked" expanded="1" source="./data/gujarat_power.geojson" providerKey="ogr"/>
    <layer-tree-layer name="Railway Stations (Western Railway)" id="railway_stations" checked="Qt::Checked" expanded="1" source="./data/gujarat_stations.geojson" providerKey="ogr"/>
    <layer-tree-layer name="Railway Corridors" id="railways" checked="Qt::Checked" expanded="1" source="./data/gujarat_railways.geojson" providerKey="ogr"/>
    <layer-tree-layer name="National Highways and Expressways" id="roads" checked="Qt::Checked" expanded="1" source="./data/gujarat_roads.geojson" providerKey="ogr"/>
    <layer-tree-layer name="Seismic, Cyclone, Flood &amp; Ecological Hazards" id="environment_disaster" checked="Qt::Checked" expanded="1" source="./data/gujarat_environment_disaster.geojson" providerKey="ogr"/>
    <layer-tree-layer name="CGWB Aquifer Extraction &amp; Salinity Profiles" id="groundwater_geology" checked="Qt::Checked" expanded="1" source="./data/gujarat_groundwater_geology.geojson" providerKey="ogr"/>
    <layer-tree-layer name="District Boundaries (Gujarat)" id="districts" checked="Qt::Checked" expanded="1" source="./data/gujarat_districts.geojson" providerKey="ogr"/>
  </layer-tree-group>
  <mapcanvas>
    <units>degrees</units>
    <extent>
      <xmin>68.10</xmin>
      <ymin>20.10</ymin>
      <xmax>74.50</xmax>
      <ymax>24.75</ymax>
    </extent>
    <destinationsrs>
      <spatialrefsys>
        <authid>EPSG:4326</authid>
        <description>WGS 84</description>
        <srid>4326</srid>
      </spatialrefsys>
    </destinationsrs>
  </mapcanvas>
  <projectlayers>
    <maplayer type="vector" id="district_hq" name="District Headquarters Nodes" readOnly="0">
      <id>district_hq</id>
      <datasource>./data/gujarat_district_hq.geojson</datasource>
      <keywordList><value></value></keywordList>
      <layername>District Headquarters Nodes</layername>
      <srs>
        <spatialrefsys>
          <authid>EPSG:4326</authid>
          <description>WGS 84</description>
          <srid>4326</srid>
        </spatialrefsys>
      </srs>
      <provider encoding="UTF-8">ogr</provider>
    </maplayer>
